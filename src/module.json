{
  "id": "drumbus",
  "name": "Drum Bus",
  "abbrev": "DBUS",
  "version": "0.1.0",
  "author": "legsmechanical",
  "license": "MIT",
  "description": "Drum-bus glue: one-knob compression that only ever attenuates, a spectrum-neutral saturator, and orthogonal attack/sustain shaping.",
  "dsp": "drumbus.so",
  "api_version": 2,
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "audio_in": true,
    "chain_params": [
      { "key": "compress", "name": "Compress", "type": "float", "min": 0.0,   "max": 1.0,  "step": 0.01, "default": 0.0 },
      { "key": "crunch",   "name": "Crunch",   "type": "float", "min": 0.0,   "max": 1.0,  "step": 0.01, "default": 0.0 },
      { "key": "attack",   "name": "Attack",   "type": "float", "min": -1.0,  "max": 1.0,  "step": 0.02, "default": 0.0 },
      { "key": "sustain",  "name": "Sustain",  "type": "float", "min": -1.0,  "max": 1.0,  "step": 0.02, "default": 0.0 },
      { "key": "mix",      "name": "Dry/Wet",  "type": "float", "min": 0.0,   "max": 1.0,  "step": 0.01, "default": 1.0 },
      { "key": "output",   "name": "Output",   "type": "float", "min": -24.0, "max": 12.0, "step": 0.5,  "default": 0.0, "unit": "dB" }
    ]
  }
}
